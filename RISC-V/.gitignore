vivado*.log
vivado*.jou
vivado*.str
vivado_pid*.str
vivado_pid*.zip
webtalk*.log
webtalk*.jou
hs_err_pid*.log
xsim.dir/
xsim*.log
xelab*.log
xvlog*.log
xvhdl*.log
*.pb
*.backup.log
*.backup.jou
.jobs/

